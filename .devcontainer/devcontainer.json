{
  "name": "MAX-1102 Airflow",
  "build": {"dockerfile": "Dockerfile"},
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Airflow",
      "onAutoForward": "notify"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "remoteUser": "codespace"
}
